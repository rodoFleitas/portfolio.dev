---
import ArrowIcon from "../icons/Arrow.astro";

interface Props {
  title: string;
  description: string;
  link?: string;
  titleLink?: string;
  date: string;
}

const { title, description, link, titleLink, date } = Astro.props;
---

<div
  class="absolute w-3 h-3 rounded-full mt-1.5 -start-1.5 border border-gray-900 bg-gray-700"
>
</div>
<time class="mb-1 text-sm font-semibold leading-none">{date}</time>
<h3 class="text-lg font-semibold text-[#711DB0] dark:text-[#5D3587] mt-2">
  {title}
</h3>
<p class="mb-4 text-base font-normal dark:text-gray-200 text-pretty">
  {description}
</p>
{
  link && (
    <a
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      class="bg-white/5 border dark:border-white/10 border-gray-300 rounded-full inline-flex justify-center items-center gap-x-2 py-1 px-2 md:py-2 md:px-4 text-xs md:text-base transition hover:scale-105 hover:bg-white/10"
    >
      {titleLink || "Saber más"} <ArrowIcon />
    </a>
  )
}
