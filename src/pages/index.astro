---
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Badge from "../components/Badge.astro";
import SocialPill from "../components/SocialPill.astro";
import GitHubIcon from "../icons/GitHub.astro";
import LinkedInIcon from "../icons/LinkedIn.astro";
import MailIcon from "../icons/Mail.astro";
import PDFIcon from "../icons/PDF.astro";
import Experience from "../components/Experience.astro";
import SubtaskIcon from "../icons/Subtask.astro";
import CodeIcon from "../icons/Code.astro";
import Projects from "../components/Projects.astro";
---

<Layout
  title="Portfolio de Rodolfo Fleitas Arce - Desarrollador y Programador Web con 3 años de experiencia"
  description="Contrata a Rodolfo para crear tu aplicacion web o movil."
>
  <main class="px-4">
    <SectionContainer id="about-me" class="py-40 pb-24">
      <img
        class="rounded-full size-16 mb-4"
        src="/logo-rodo.webp"
        alt="Foto de perfil"
      />
      <h1
        class="text-gray-900 dark:text-white text-3xl md:text-4xl lg:text-5xl font-bold flex flex-col items-start gap-y-4 md:flex-row md:items-center gap-x-4 pb-6 lg:pb-10"
      >
        Hey, soy Rodolfo <a
          href="https://www.linkedin.com/in/rodo-fleitas/"
          target="_blank"
          rel="noopener"
          class="flex justify-center items-center"
        >
          <Badge>Disponible para trabajar</Badge>
        </a>
      </h1>
      <h2
        class="tetx-xl md:text-2xl text-balance max-w-[700px] text-black dark:text-white"
      >
        +3 años de experiencia. <span class="text-[#711DB0] dark:text-[#5D3587]"
          >Desarrollador Web Full Stack y estudiante de Audioviasuales.</span
        >
        De La Plata, Buenos Aires. Especializado en crear aplicaciones unicas.
      </h2>

      <nav class="flex gap-3 mt-8 flex-wrap">
        <SocialPill href="https://www.linkedin.com/in/rodo-fleitas/">
          <LinkedInIcon class="size-4 md:size-6" />
          Linkedin
        </SocialPill>

        <SocialPill href="https://github.com/rodoFleitas">
          <GitHubIcon class="size-4 md:size-6" />
          GitHub
        </SocialPill>

        <SocialPill href="mailto:rfleitasarce@gmail.com">
          <MailIcon class="size-4 md:size-6" />
          rfleitasarce@gmail.com
        </SocialPill>

        <SocialPill
          href="/public/CV.pdf"
          download="Rodolfo Rodrigo Fleitas Arce - Full Stack Web Developer - CV"
        >
          <PDFIcon class="size-4 md:size-6" />
          CV
        </SocialPill>
      </nav>
    </SectionContainer>

    <SectionContainer id="experience">
      <h2
        class="text-3xl font-semibold mb-8 flex gap-x-3 items-center text-black/80 dark:text-white/80"
      >
        <SubtaskIcon class="size-7" />
        Experiencia laboral
      </h2>
      <Experience />
    </SectionContainer>

    <SectionContainer id="projects">
      <h2
        class="text-3xl font-semibold mb-8 flex gap-x-3 items-center text-black/80 dark:text-white/80"
      >
        <CodeIcon class="size-7" />
        Proyectos
      </h2>
      <Projects />
    </SectionContainer>
  </main>
</Layout>
